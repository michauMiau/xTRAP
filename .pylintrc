[MASTER]
# rcar.py runs on MicroPython with MicroHydra's bundled libs (lib.hydra,
# lib.userinput, lib.battlevel) and MicroPython's own machine/network modules.
# None of those exist in CI, so import-error must stay off for that file.
ignore-patterns=test_.*?py,rcar\.py

disable=
    missing-module-docstring,
    missing-function-docstring,
    missing-class-docstring,
    invalid-name,
    too-few-public-methods,
    no-member,
    broad-exception-caught,
    logging-fstring-interpolation,
    too-many-nested-blocks,
    too-many-branches,
    protected-access,
    too-many-instance-attributes,
    unused-argument,
    trailing-whitespace,
    f-string-without-interpolation,
    missing-final-newline

# import-error stays ON for src/ (see ignore-patterns): a typo'd `import log`
# killed the app at startup, and Pylint was the only check that could catch it.

[FORMAT]
max-line-length=120

[DESIGN]
max-args=6
